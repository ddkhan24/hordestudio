# A domain you own. This is only the address: you must also point its A/AAAA
# record at the host, allow ports 80/443, and run the Compose stack below.
VH2_DOMAIN=vh.example.com

# You create this server password; Horde and the host do not issue it.
# Generate it once on the server with: openssl rand -hex 32
# Put the exact 64-character output here without quotes or spaces, then paste
# that same value into Horde Studio. Do not use an AI-provider API key here.
HORDE_VH2_ACCESS_TOKEN=replace-with-at-least-32-random-characters

# Exact browser origins that open Horde Studio. Copy the current origin from
# the Prepare screen; this is normally NOT the VH2 server domain.
# Scheme, host, and port must match. Comma-separated; no wildcard origins.
HORDE_VH2_ALLOWED_ORIGINS=http://127.0.0.1:43127,http://localhost:43127
